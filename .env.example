# Backend environment variables (copy to .env)
PORT=5000

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=salons

# JWT
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=1h

# Google Play review login bypass (optional)
GOOGLE_PLAY_REVIEW_ENABLED=false
GOOGLE_PLAY_REVIEW_PHONE=9999999999
GOOGLE_PLAY_REVIEW_OTP=123456

# Partner Google Play review login bypass (optional)
PARTNER_GOOGLE_PLAY_REVIEW_ENABLED=false
PARTNER_GOOGLE_PLAY_REVIEW_PHONE=9999999999
PARTNER_GOOGLE_PLAY_REVIEW_OTP=123456

# SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
FRONTEND_URL=https://secure-portal-r9k.voguee.co.in

# Razorpay (optional)
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
